{
  "name": "simplewar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint src",
    "react-doctor": "pnpm dlx react-doctor@latest --verbose",
    "format": "vp fmt .",
    "type-check": "tsc --noEmit --pretty false",
    "test": "vp test run",
    "test:unit": "vp test run --exclude '**/*.integration.test.ts'",
    "test:integration": "vp test run .integration.test.ts",
    "fsd-check": "steiger ./src",
    "preview": "vp preview",
    "lint-staged": "lint-staged",
    "lint:length": "node scripts/check-file-length.ts",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "check": "vp check && pnpm fsd-check && pnpm test"
  },
  "dependencies": {
    "@types/pathfinding": "^0.1.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.3",
    "normalize.css": "^8.0.1",
    "pathfinding": "^0.4.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplex-noise": "^4.0.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "steiger": "^0.6.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
